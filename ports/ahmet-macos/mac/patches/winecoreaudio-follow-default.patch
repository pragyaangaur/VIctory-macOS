-static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID adevid)
+static BOOL follow_default_output(void)
 {
+    const char *env = getenv("VICTORY_AUDIO_FOLLOW_DEFAULT");
+    return !env || strcmp(env, "0") != 0;
+}
+
+static AudioDeviceID current_stream_dev_id(const struct coreaudio_stream *stream)
+{
+    if (stream->flow == eRender && follow_default_output()) {
+        AudioDeviceID cur = kAudioObjectUnknown;
+        UInt32 size = sizeof(cur);
+        const AudioObjectPropertyAddress addr = {
+            kAudioHardwarePropertyDefaultOutputDevice,
+            kAudioObjectPropertyScopeGlobal,
+            kAudioObjectPropertyElementMain
+        };
+        if (stream->unit &&
+            AudioUnitGetProperty(stream->unit, kAudioOutputUnitProperty_CurrentDevice,
+                                 kAudioUnitScope_Global, 0, &cur, &size) == noErr &&
+            cur != kAudioObjectUnknown)
+            return cur;
+        size = sizeof(cur);
+        if (AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, 0, NULL, &size, &cur) == noErr &&
+            cur != kAudioObjectUnknown)
+            return cur;
+    }
+    return stream->dev_id;
+}
+
+static AudioComponentInstance get_audiounit(EDataFlow dataflow, AudioDeviceID adevid, BOOL follow_default)
